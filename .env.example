# Postgres connection string used by drizzle-orm (see src/db/index.ts)
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# --- Sign-in (Clerk) -----------------------------------------------------
# 1. Sign up free at https://clerk.com and create an application named "Linkslo"
# 2. In that application, enable "Google" as a sign-in option (one click,
#    works immediately in development — no Google Cloud Console needed)
# 3. Go to "API Keys" in the Clerk dashboard and copy both values below
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

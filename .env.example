# Postgres connection string used by drizzle-orm (see src/db/index.ts)
DATABASE_URL=<redacted>

# --- Admin panel -----------------------------------------------------------
# Password for /admin/login (compared server-side, never exposed to clients).
ADMIN_PASSWORD=change-me-to-a-long-random-string
# Secret used to sign the admin session cookie. Generate a random 32+ char value.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- PayPal checkout -------------------------------------------------------
# Server-side payment verification (src/lib/paypal.ts) requires the REST API
# secret that pairs with the public client ID in src/lib/paypal.ts.
# Without it, /api/orders refuses to create orders (fail-closed).
# Find it at https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_SECRET=your-paypal-rest-api-secret
# Defaults to live (https://api-m.paypal.com). For sandbox testing use:
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- Email notifications (Resend) ------------------------------------------
# Order/lead notification emails. If unset, the app logs a notice and skips
# sending instead of crashing.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Linkslo Orders <orders@linkslo.com>

# --- Admin notifications ---------------------------------------------------
# Order alert emails go to this address.
ADMIN_EMAIL=seoweblitewebservice@gmail.com

# --- Buyer accounts (self-hosted auth) -------------------------------------
# Sign-in / registration is email + password with bcrypt hashes and opaque
# session tokens stored in Postgres (tables: users, user_sessions).
# ZERO new env vars are required — everything runs off DATABASE_URL.
# Before deploying, apply the schema to the production database once:
#   npm run db:push
# (drizzle-kit push reads DATABASE_URL and creates the missing tables.)
